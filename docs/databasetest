// --- NHÓM TỔ CHỨC ---
Table organizations {
  id integer [primary key]
  name varchar
  created_at timestamp
}

Table regions {
  id integer [primary key]
  org_id integer [ref: > organizations.id]
  name varchar
  enroll_token varchar [unique] // Mã định danh cho từng vùng
}

// --- NHÓM NGƯỜI DÙNG & PHÂN QUYỀN ---
Table users {
  id integer [primary key]
  org_id integer [ref: > organizations.id]
  username varchar [unique]
  password_hash varchar
  role_level integer // 1: Global, 2: Staff, 3: SME Admin, 4: SME Staff
  totp_secret varchar
}
// --- THÊM MỚI: NHÓM QUẢN LÝ TUÂN THỦ ---
Table usb_whitelist {
  id integer [primary key]
  org_id integer [ref: > organizations.id]
  device_id varchar // VID_PID_Serial thực tế
  friendly_name varchar // Tên gợi nhớ (VD: USB Kế toán 01)
  assigned_to varchar // Tên nhân viên được cấp để truy cứu trách nhiệm
  created_at timestamp
}

Table software_policies {
  id integer [primary key]
  org_id integer [ref: > organizations.id]
  software_name varchar
  is_prohibited boolean [default: false] // true: Cấm, false: Được phép
  min_version varchar // Phiên bản tối thiểu yêu cầu
  created_at timestamp
}
Table user_permissions {
  id integer [primary key]
  user_id integer [ref: > users.id]
  region_id integer [ref: > regions.id] // R4 chỉ được xem vùng này
  can_approve_agent boolean
  can_view_logs boolean
  can_manage_usb boolean
}

// --- NHÓM THIẾT BỊ (ASSETS) ---
Table agents {
  hwid varchar [primary key] // Định danh thực tế
  org_id integer [ref: > organizations.id]
  region_id integer [ref: > regions.id]
  hostname varchar
  status varchar // online/offline
  last_seen timestamp
}

Table agent_inventory {
  id integer [primary key]
  hwid varchar [ref: - agents.hwid]
  cpu_model varchar
  ram_total_gb integer
  os_info varchar
}

Table software_inventory {
  id integer [primary key]
  hwid varchar [ref: > agents.hwid]
  software_name varchar
  version varchar
  installed_at timestamp
}

Table agent_snapshots {
  hwid varchar [primary key, ref: - agents.hwid]
  last_software_hash varchar // Phục vụ Differential Reporting
  last_port_hash varchar
}

// --- NHÓM GIÁM SÁT AN NINH ---
Table open_ports {
  id integer [primary key]
  hwid varchar [ref: > agents.hwid]
  port integer
  process_name varchar // Lấy từ Agent v2.1
  scan_timestamp timestamp
}

Table usb_logs {
  id integer [primary key]
  hwid varchar [ref: > agents.hwid]
  device_name varchar
  device_id varchar // VID_PID_Serial thực tế
  is_whitelisted boolean
  event_type varchar // plugged / unplugged
  created_at timestamp
}

Table security_events {
  id integer [primary key]
  hwid varchar [ref: > agents.hwid]
  event_id integer
  message text // Log từ PowerShell Get-WinEvent
  created_at timestamp
}

Table security_alerts {
id integer [primary key]
  org_id integer [ref: > organizations.id]
  hwid varchar [ref: > agents.hwid]
  alert_type varchar // 'USB_UNAUTHORIZED' hoặc 'SOFTWARE_VIOLATION'
  title varchar
  description text
  severity varchar // low, medium, high, critical
  is_resolved boolean
  created_at timestamp
}